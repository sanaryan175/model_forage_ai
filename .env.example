# ── Application ──────────────────────────────────────────────
APP_ENV=development
AWS_MODE=mock
LOG_LEVEL=INFO

# ── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────
# Port 5433 (not 5432) avoids clashing with a native Postgres install on the host.
# The `backend` service inside docker-compose talks to the `postgres` container on 5432 internally.
DATABASE_URL=postgresql+psycopg://modelforge:modelforge@localhost:5433/modelforge
POSTGRES_USER=modelforge
POSTGRES_PASSWORD=modelforge
POSTGRES_DB=modelforge

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Local storage (used when AWS_MODE=mock) ─────────────────
LOCAL_STORAGE_ROOT=./storage

# ── AWS (used when AWS_MODE=aws) ────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=modelforge-models
SQS_TFLITE_QUEUE=modelforge-tflite
SQS_TENSORRT_QUEUE=modelforge-tensorrt
SQS_COREML_QUEUE=modelforge-coreml
ECR_REPOSITORY=modelforge

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
