# AWS mode: API on the laptop, files in S3, jobs on SQS, data in RDS.
# Copy to backend/.env.aws (git-ignored) and fill in from `terraform output`.
# Use it with:  $env:ENV_FILE=".env.aws"   before starting the API or the TensorRT worker.
APP_ENV=development
AWS_MODE=aws
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

AWS_REGION=ap-south-1
AWS_PROFILE=modelforge
S3_BUCKET=<terraform output -raw s3_bucket>
SQS_CPU_QUEUE=modelforge-cpu
SQS_TENSORRT_QUEUE=modelforge-tensorrt
DATABASE_URL=<terraform output -raw database_url>

JWT_SECRET=<long random string>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
